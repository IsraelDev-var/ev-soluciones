// Cloudflare Worker that serves the static site in dist/ (no build step: run scripts/build.py locally).
{
  "name": "ev-soluciones",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
